{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:recevobench:schema:scorecard:1.0",
  "title": "RecEvoBench single-run scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "run_id", "agent_id", "random_seed",
    "primary_metric", "baseline_test_metric", "final_test_metric",
    "absolute_improvement", "relative_improvement", "normalized_improvement",
    "meaningful_improvement", "hidden_auc_over_budget",
    "first_improvement_compute_fraction", "time_to_90_percent_compute_fraction",
    "late_gain_fraction", "selection_regret", "valid_trial_ratio", "status_counts",
    "promoted_regression_rate", "compute_units_used", "gpu_seconds_used",
    "compute_seconds_used", "wall_seconds_used", "tokens_used",
    "human_interventions", "budget_compliant", "budget_violations",
    "guardrails_passed", "guardrails", "diagnosis_top1_accuracy",
    "diagnosis_top3_accuracy", "repair_success_rate", "self_evolution_verified",
    "evolution_evidence_level", "autonomous_run", "human_interventions_per_trial",
    "validation_test_gap", "public_hidden_spearman", "productive_trial_ratio",
    "feedback_conversion_rate", "misleading_feedback_rate",
    "successful_revision_ratio", "iterative_revision_ratio",
    "post_failure_recovery_rate", "regression_recovery_rate",
    "wasted_compute_fraction", "best_improvement_compute_fraction",
    "hidden_improvement_per_compute_unit", "max_lineage_depth",
    "search_branching_ratio", "unique_candidate_ratio",
    "successful_revision_count", "successful_iterative_revision_count", "code_exploration_reach",
    "code_exploration_spread", "structural_unique_candidate_ratio"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "random_seed": {"type": "integer"},
    "primary_metric": {"type": "string", "minLength": 1},
    "baseline_test_metric": {"type": "number"},
    "final_test_metric": {"type": "number"},
    "absolute_improvement": {"type": "number"},
    "relative_improvement": {"type": ["number", "null"]},
    "normalized_improvement": {"type": ["number", "null"]},
    "meaningful_improvement": {"type": "boolean"},
    "hidden_auc_over_budget": {"type": ["number", "null"]},
    "first_improvement_compute_fraction": {"$ref": "#/$defs/nullableFraction"},
    "time_to_90_percent_compute_fraction": {"$ref": "#/$defs/nullableFraction"},
    "late_gain_fraction": {"$ref": "#/$defs/nullableFraction"},
    "selection_regret": {"type": ["number", "null"]},
    "valid_trial_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "promoted_regression_rate": {"$ref": "#/$defs/nullableFraction"},
    "compute_units_used": {"type": "number", "minimum": 0},
    "gpu_seconds_used": {"type": "number", "minimum": 0},
    "compute_seconds_used": {"type": "number", "minimum": 0},
    "wall_seconds_used": {"type": "number", "minimum": 0},
    "tokens_used": {"type": "integer", "minimum": 0},
    "human_interventions": {"type": "integer", "minimum": 0},
    "budget_compliant": {"type": "boolean"},
    "budget_violations": {"type": "array", "items": {"type": "string"}},
    "guardrails_passed": {"type": "boolean"},
    "guardrails": {"type": "array", "items": {"$ref": "#/$defs/guardrail"}},
    "diagnosis_top1_accuracy": {"$ref": "#/$defs/nullableFraction"},
    "diagnosis_top3_accuracy": {"$ref": "#/$defs/nullableFraction"},
    "repair_success_rate": {"$ref": "#/$defs/nullableFraction"},
    "self_evolution_verified": {"type": "boolean"},
    "evolution_evidence_level": {
      "enum": ["none", "outcome_only", "autonomous_outcome", "iterative", "autonomous_iterative"]
    },
    "autonomous_run": {"type": "boolean"},
    "human_interventions_per_trial": {"type": "number", "minimum": 0},
    "validation_test_gap": {"type": ["number", "null"], "minimum": 0},
    "public_hidden_spearman": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "productive_trial_ratio": {"$ref": "#/$defs/fraction"},
    "feedback_conversion_rate": {"$ref": "#/$defs/nullableFraction"},
    "misleading_feedback_rate": {"$ref": "#/$defs/nullableFraction"},
    "successful_revision_ratio": {"$ref": "#/$defs/nullableFraction"},
    "iterative_revision_ratio": {"$ref": "#/$defs/fraction"},
    "post_failure_recovery_rate": {"$ref": "#/$defs/nullableFraction"},
    "regression_recovery_rate": {"$ref": "#/$defs/nullableFraction"},
    "wasted_compute_fraction": {"$ref": "#/$defs/fraction"},
    "best_improvement_compute_fraction": {"$ref": "#/$defs/nullableFraction"},
    "hidden_improvement_per_compute_unit": {"type": ["number", "null"], "minimum": 0},
    "max_lineage_depth": {"type": "integer", "minimum": 0},
    "search_branching_ratio": {"$ref": "#/$defs/fraction"},
    "unique_candidate_ratio": {"$ref": "#/$defs/nullableFraction"},
    "successful_revision_count": {"type": "integer", "minimum": 0},
    "successful_iterative_revision_count": {"type": "integer", "minimum": 0},
    "code_exploration_reach": {"$ref": "#/$defs/nullableFraction"},
    "code_exploration_spread": {"$ref": "#/$defs/nullableFraction"},
    "structural_unique_candidate_ratio": {"$ref": "#/$defs/nullableFraction"}
  },
  "$defs": {
    "fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "nullableFraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "baseline", "final", "degradation", "allowed_degradation", "passed", "reason"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "baseline": {"type": ["number", "null"]},
        "final": {"type": ["number", "null"]},
        "degradation": {"type": ["number", "null"], "minimum": 0},
        "allowed_degradation": {"type": ["number", "null"], "minimum": 0},
        "passed": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    }
  }
}
