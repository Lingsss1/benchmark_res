include LICENSE NOTICE README.md README.en.md
include CHANGELOG.md CITATION.cff CODE_OF_CONDUCT.md CONTRIBUTING.md SECURITY.md
recursive-include docs *.md
recursive-include docker *
recursive-include examples *.json *.py
recursive-include schemas *.json
recursive-include seed *.py *.json
recursive-include tasks *.json
recursive-include tests *.py *.csv *.jsonl
recursive-include .github *.yml
include .dockerignore .gitignore .pre-commit-config.yaml uv.lock
