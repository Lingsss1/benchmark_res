{
  "schema_version": "1.0",
  "task_id": "kuairec-watchtime-v0",
  "title": "KuaiRec watch-time prediction under exposure shift",
  "dataset_family": "KuaiRec",
  "task_type": "watch_time_ranking_and_regression",
  "primary_metric": {
    "name": "xAUC",
    "direction": "maximize",
    "lower_bound": 0.0,
    "upper_bound": 1.0,
    "absolute_epsilon": 0.001,
    "relative_epsilon": 0.005
  },
  "secondary_metrics": [
    "MAE",
    "UserSpearman",
    "NDCG@10_HighWatch",
    "FullyObserved_xAUC"
  ],
  "guardrails": [
    {
      "metric": "MAE",
      "direction": "minimize",
      "max_relative_degradation": 0.01
    },
    {
      "metric": "FullyObserved_xAUC",
      "direction": "maximize",
      "max_relative_degradation": 0.01
    },
    {
      "metric": "InferenceP95Ms",
      "direction": "minimize",
      "max_relative_degradation": 0.20
    }
  ],
  "budget": {
    "max_compute_units": 24.0,
    "max_trials": 64,
    "max_wall_seconds": 43200,
    "max_tokens": 5000000
  },
  "splits": [
    {
      "name": "train_big_matrix",
      "visibility": "public",
      "purpose": "model fitting on naturally exposed interactions"
    },
    {
      "name": "feedback_dev_big_matrix",
      "visibility": "public",
      "purpose": "fast watch-time feedback exposed to the agent"
    },
    {
      "name": "hidden_select_big_matrix",
      "visibility": "hidden",
      "purpose": "consistent candidate selection diagnostics"
    },
    {
      "name": "sealed_test_small_matrix",
      "visibility": "sealed",
      "purpose": "final evaluation on the fully observed matrix"
    }
  ],
  "evaluation_protocol": {
    "split_strategy": "frozen user-aware chronological split",
    "feedback_source": "big_matrix",
    "sealed_source": "small_fully_observed_matrix",
    "primary_target": "watch_ratio",
    "xauc_scope": "global_and_user_stratified",
    "frozen_randomness": true,
    "required_strata": [
      "low_vs_high_activity_user",
      "short_vs_long_video",
      "low_vs_high_exposure_item"
    ]
  },
  "editable_paths": [
    "**/*.py",
    "config/**"
  ],
  "recovery_protocol": {
    "enabled": true,
    "default_episodes": 2,
    "fault_catalog": [
      "point_signal_inverted",
      "item_signal_inverted",
      "user_signal_inverted"
    ],
    "selection": "seeded_without_replacement"
  },
  "runtime": {
    "seed_workspace": "seed/simple_rec",
    "train_command": ["python", "train.py", "--train", "{train}", "--model-out", "{model}"],
    "predict_command": ["python", "predict.py", "--mode", "point", "--model", "{model}", "--input", "{split}", "--output-dir", "{predictions}"],
    "model_artifact": "artifacts/model.json",
    "prediction_format": "point-csv",
    "latency_repeats": 20,
    "latency_sample_rows": 128
  },
  "artifact_policy": {
    "required_candidate_files": ["train.py", "predict.py", "model.py"],
    "max_candidate_bytes": 104857600
  },
  "metadata": {
    "dataset_path": "DATASET_ROOT/kuairec",
    "official_source": "https://kuairec.com/",
    "notes": "The fully observed matrix is sealed to test dependence on the logging policy."
  }
}
